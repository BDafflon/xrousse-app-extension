{
  "manifest_version": 3,
  "name": "Reco Croix-Rousse",
  "version": "0.1.0",
  "description": "Capturez rapidement un événement vu sur le web vers un brouillon Reco Croix-Rousse.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "reco-croixrousse@dafflon.fr",
      "data_collection_permissions": {
      "required": ["none"]
    },
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["storage", "contextMenus", "activeTab", "notifications", "scripting"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["vendor/browser-polyfill.js", "src/storage.js", "src/api.js", "src/background.js"]
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
